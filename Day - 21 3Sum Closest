class Solution {
        public int threeSumClosest(int[] arr, int target) {
            if (arr == null || arr.length < 3) return 0;

             int i = 0;
              int j = 1;
             int k = 2;
             int ans = arr[0] + arr[1] + arr[2];
             int dis = Math.abs(ans - target);

             int n = arr.length;

             while (i < n - 2) {
               if (k < n) {
                int sum = arr[i] + arr[j] + arr[k];
                int diff = Math.abs(sum - target);

                        if (diff < dis) {
                            dis = diff;
                            ans = sum;
                            if (dis == 0) return ans;
                            }
                            k++;
                            } else if (j < n - 2) {
                                 j++;
                                  k = j + 1;
                               } else {
                                  i++;
                                  j = i + 1;
                                  k = j + 1;
                                  }
                            }
        return ans;
    }
}

